{
  "name": "@goodfish/jarvy",
  "version": "0.20.1",
  "description": "A local chat where people and AI Bots work together: DMs, channels and threads, with long-running Pi agents as members.",
  "keywords": [
    "chat",
    "ai",
    "agent",
    "bot",
    "pi",
    "self-hosted",
    "local-first"
  ],
  "homepage": "https://github.com/AzzzGoodFish/Jarvy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzzzGoodFish/Jarvy.git"
  },
  "bugs": {
    "url": "https://github.com/AzzzGoodFish/Jarvy/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "jarvy": "dist/server/cli.js"
  },
  "files": [
    "dist/server",
    "dist/web",
    "licenses",
    "skills",
    "THIRD_PARTY_NOTICE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run check:architecture && npm run lint && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json && vite build && node scripts/bundle-server.mjs",
    "dev:web": "vite",
    "start": "node dist/server/cli.js server run",
    "lint": "eslint src",
    "check:architecture": "node scripts/check-boundaries.mjs && node scripts/check-i18n.mjs && node scripts/check-design.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "@earendil-works/pi-env": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@hono/node-server": "2.1.3",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "hono": "4.13.11",
    "proper-lockfile": "4.1.2",
    "sharp": "0.35.5",
    "typebox": "1.3.27",
    "undici": "8.10.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "agentation": "3.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.0"
  }
}
