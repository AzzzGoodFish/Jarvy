{
  "name": "@goodfish/jarvy",
  "version": "0.1.0",
  "description": "A local chat where people and AI Bots work together: DMs, channels and threads, with long-running Pi agents as members.",
  "keywords": [
    "chat",
    "ai",
    "agent",
    "bot",
    "pi",
    "self-hosted",
    "local-first"
  ],
  "homepage": "https://github.com/AzzzGoodFish/Jarvy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AzzzGoodFish/Jarvy.git"
  },
  "bugs": {
    "url": "https://github.com/AzzzGoodFish/Jarvy/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "bin": {
    "jarvy": "dist/server/cli.js"
  },
  "files": [
    "dist/server",
    "dist/web",
    "licenses",
    "THIRD_PARTY_NOTICE.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run check:architecture && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json && vite build && node scripts/bundle-server.mjs",
    "dev:web": "vite",
    "start": "node dist/server/cli.js run",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@hono/node-server": "2.1.3",
    "hono": "4.13.11",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.27",
    "undici": "8.10.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.3.0",
    "agentation": "3.1.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "esbuild": "^0.25.12",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
