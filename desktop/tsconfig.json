{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "ws": ["./node_modules/@types/ws"] },
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
