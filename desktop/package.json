{
  "name": "jarvy-desktop",
  "productName": "Jarvy",
  "version": "0.1.1",
  "description": "The Jarvy desktop client: Jarvy in a window, and this computer connected to it for Bots to work on.",
  "license": "Apache-2.0",
  "author": "AzzzGoodFish",
  "homepage": "https://github.com/AzzzGoodFish/Jarvy",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "ws": "8.22.0"
  },
  "build": {
    "appId": "com.goodfish.jarvy",
    "productName": "Jarvy",
    "artifactName": "Jarvy-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "dist/static"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "dist/static/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Jarvy"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "dist/static/icon.png",
      "category": "Network"
    }
  }
}
