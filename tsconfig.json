{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist/server",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/server/**/*.ts",
    "src/contract/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
